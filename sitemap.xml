---
layout: null
---
{%- comment -%}
  Pages carrying `noindex_when_incomplete` (the legal pages) stay out of the sitemap
  until the address in _config.yml `legal:` is filled in — same gate as the noindex
  meta tag in _layouts/default.html and the footer links.
{%- endcomment -%}
{%- assign legal_ready = false -%}
{%- if site.legal.street != '' and site.legal.city != '' -%}{%- assign legal_ready = true -%}{%- endif -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.html_pages %}
  {% unless page.url contains '404' %}
  {% unless page.noindex_when_incomplete and legal_ready == false %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {% endunless %}
  {% endunless %}
  {% endfor %}
  {%- comment -%}
    site.html_pages does not include collection documents (P1-1's per-topic
    docs pages) — list the two docs collections explicitly.
  {%- endcomment -%}
  {% for doc in site.docs_getting_started %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  {% for doc in site.docs_gpu %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
