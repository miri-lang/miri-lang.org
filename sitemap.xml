---
layout: null
---
{%- comment -%}
  Pages carrying `noindex_when_incomplete` (the legal pages) stay out of the sitemap
  until the address in _config.yml `legal:` is filled in — same gate as the noindex
  meta tag in _layouts/default.html and the footer links.
{%- endcomment -%}
{%- assign legal_ready = false -%}
{%- if site.legal.street != '' and site.legal.city != '' -%}{%- assign legal_ready = true -%}{%- endif -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.html_pages %}
  {% unless page.url contains '404' %}
  {%- include gates.html -%}
  {%- assign gate_closed = false -%}
  {%- if page.gate == 'blog' and blog_ready == false -%}{%- assign gate_closed = true -%}{%- endif -%}
  {%- if page.gate == 'bench' and bench_ready == false -%}{%- assign gate_closed = true -%}{%- endif -%}
  {%- if page.noindex_when_incomplete and legal_ready == false -%}{%- assign gate_closed = true -%}{%- endif -%}
  {% unless gate_closed %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {% endunless %}
  {% endunless %}
  {% endfor %}
  {%- comment -%}
    site.html_pages does not include collection documents (P1-1's per-topic
    docs pages) — list the docs collections explicitly.
  {%- endcomment -%}
  {% for doc in site.docs_getting_started %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  {% for doc in site.docs_gpu %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  {% for doc in site.docs_agents %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  {%- comment -%}
    P1-2's per-demo pages (_gpu_demos/) are collection documents too, so they
    don't show up in site.html_pages either.
  {%- endcomment -%}
  {% for doc in site.gpu_demos %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
